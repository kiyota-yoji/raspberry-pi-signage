[Unit]
Description=Import signage settings and Wi-Fi from the SD card boot partition
Wants=NetworkManager.service
After=local-fs.target NetworkManager.service
# 再生・同期より先に設定を反映する
Before=signage-player.service signage-sync.service

[Service]
Type=oneshot
Environment=PYTHONPATH=/opt/signage
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m signage bootimport
SuccessExitStatus=1
TimeoutStartSec=5min

[Install]
WantedBy=multi-user.target
